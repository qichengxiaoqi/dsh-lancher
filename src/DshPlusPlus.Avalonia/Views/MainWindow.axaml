<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DshPlusPlus.Avalonia.ViewModels"
        xmlns:views="using:DshPlusPlus.Avalonia.Views"
        x:Class="DshPlusPlus.Avalonia.Views.MainWindow"
        Title="dsh++ · DeepSeek Harness"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121923" />
      <Setter Property="BorderBrush" Value="#233244" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8C9AAC" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#39D9FF" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="Foreground" Value="#F4F8FC" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#39D9FF" />
      <Setter Property="Foreground" Value="#071017" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#182331" />
      <Setter Property="Foreground" Value="#DCE9F5" />
      <Setter Property="BorderBrush" Value="#2A3B50" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8C9AAC" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#1B2A38" />
      <Setter Property="Foreground" Value="#F4F8FC" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#123B4B" />
      <Setter Property="Foreground" Value="#39D9FF" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#0E151E" />
      <Setter Property="Foreground" Value="#EDF5FC" />
      <Setter Property="BorderBrush" Value="#2A3B50" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#DCE9F5" />
      <Setter Property="Margin" Value="0,7" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DshManagementPageViewModel}"><views:DshManagementView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MaintenancePageViewModel}"><views:MaintenanceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeepSeekApiPageViewModel}"><views:DeepSeekApiView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemSettingsPageViewModel}"><views:SystemSettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PluginSettingsPageViewModel}"><views:PluginSettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LauncherSettingsPageViewModel}"><views:LauncherSettingsView /></DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="Auto,*" Background="#0B0F14">
    <Border Grid.Column="0" Width="{Binding NavigationWidth}" Background="#0F151D" BorderBrush="#1C2A39" BorderThickness="0,0,1,0" Padding="14,18">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,26">
          <Border Width="38" Height="38" CornerRadius="12" Background="#39D9FF" VerticalAlignment="Center">
            <TextBlock Text="d" Foreground="#071017" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding IsNavigationExpanded}">
            <TextBlock Text="DEEPSEEK HARNESS" Classes="eyebrow" />
            <TextBlock Text="dsh++" Foreground="#F4F8FC" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" Content="‹" Padding="8,6" Margin="4,0,0,0" Command="{Binding ToggleNavigationCommand}" ToolTip.Tip="{Binding NavigationDisplayMode}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="WORKSPACE" Classes="muted" FontSize="10" Margin="6,0,0,8" IsVisible="{Binding IsNavigationExpanded}" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Pages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Title}">
                  <Grid ColumnDefinitions="32,*">
                    <TextBlock Text="{Binding Icon}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" IsVisible="{Binding ShowTitle}">
                      <TextBlock Text="{Binding Title}" FontSize="13" />
                      <TextBlock Text="{Binding Number}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="4,18,4,0">
          <TextBlock Text="{Binding PlatformLabel}" Classes="muted" FontSize="11" IsVisible="{Binding IsNavigationExpanded}" />
          <TextBlock Text="LOCAL CONTROL DECK" Classes="muted" FontSize="10" Margin="0,5,0,0" IsVisible="{Binding IsNavigationExpanded}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,24,32,24">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel>
          <TextBlock Text="{Binding CurrentPage.Eyebrow}" Classes="eyebrow" />
          <TextBlock Text="{Binding CurrentPage.Title}" Classes="display" Margin="0,5,0,0" />
          <TextBlock Text="{Binding PageSubtitle}" Classes="muted" TextWrapping="Wrap" MaxWidth="780" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="ghost" Content="Open Web UI" Command="{Binding OpenWebCommand}" />
          <Button Classes="primary" Content="Refresh" Command="{Binding CurrentPage.RefreshCommand}" />
        </StackPanel>
      </Grid>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
