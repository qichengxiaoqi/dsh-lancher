<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.5</Version>
    <InformationalVersion>0.2.5</InformationalVersion>
    <AssemblyName>dsh++</AssemblyName>
    <RootNamespace>DshPlusPlus</RootNamespace>
    <ApplicationIcon>Assets\dsh-whale.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DshPlusPlus.Core\DshPlusPlus.Core.csproj" />
    <EmbeddedResource Include="Assets\dsh-whale.png" />
  </ItemGroup>
</Project>
